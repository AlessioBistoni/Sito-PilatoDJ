# Copia questo file come ".env.local" nella root del progetto e sostituisci i valori
# con quelli da Supabase: Settings → API (Project URL + anon public key)
#
# In sviluppo (npm run dev) senza questo file, date/gallery/blog si salvano in
# .pilato-dev/app-data.json (solo sul tuo PC). In produzione serve sempre Supabase.

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opzionale (default: piluz2024)
# NEXT_PUBLIC_ADMIN_PASSWORD=tua_password_admin

# --- Notifica WhatsApp (solo server: non esporre al client) ---
# Usa CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-messages/
# 1) Apri il link dal tuo telefono e invia il messaggio di attivazione al bot
# 2) Copia l’apikey che ti risponde il bot
# CALLMEBOT_PHONE = numero WhatsApp che riceve l’avviso, solo cifre prefisso internazionale (es. 393331234567)
# CALLMEBOT_API_KEY = chiave fornita dal bot dopo l’attivazione
# CALLMEBOT_PHONE=393331234567
# CALLMEBOT_API_KEY=xxxxxx
